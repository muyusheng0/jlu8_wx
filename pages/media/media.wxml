<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <view class="header-icon">
        <van-icon name="photo-o" size="36px" color="#fff" />
      </view>
      <view class="header-text">
        <text class="title">媒体中心</text>
        <text class="subtitle">照片 · 视频 · 回忆</text>
      </view>
    </view>
  </view>

  <!-- 标签切换 -->
  <view class="media-tabs">
    <view class="media-tab {{currentTab === 'photos' ? 'active' : ''}}" bindtap="switchTab" data-tab="photos">
      <van-icon name="photo-o" size="16px" />
      <text>相册</text>
    </view>
    <view class="media-tab {{currentTab === 'videos' ? 'active' : ''}}" bindtap="switchTab" data-tab="videos">
      <van-icon name="video-o" size="16px" />
      <text>视频</text>
    </view>
    <view class="media-tab {{currentTab === 'alumni' ? 'active' : ''}}" bindtap="switchTab" data-tab="alumni">
      <van-icon name="friends-o" size="16px" />
      <text>校友会</text>
    </view>
    <view class="media-tab {{currentTab === 'news' ? 'active' : ''}}" bindtap="switchTab" data-tab="news">
      <van-icon name="newspaper-o" size="16px" />
      <text>新闻</text>
    </view>
  </view>

  <!-- 相册区域 -->
  <view class="content-area" wx:if="{{currentTab === 'photos'}}">
    <view class="media-card" bindtap="goToGallery">
      <view class="media-bg" style="background: linear-gradient(135deg, #2c3e50, #34495e);"></view>
      <view class="media-content">
        <view class="media-icon">
          <van-icon name="photo-o" size="40px" color="#fff" />
        </view>
        <view class="media-info">
          <text class="media-title">相册</text>
          <text class="media-desc">照片留念 · 定格青春</text>
        </view>
        <view class="media-count">
          <text class="count-num">{{photoCount}}</text>
          <text class="count-unit">张照片</text>
        </view>
      </view>
      <view class="media-arrow">
        <van-icon name="arrow" size="24px" color="#fff" />
      </view>
    </view>
  </view>

  <!-- 视频区域 -->
  <view class="content-area" wx:if="{{currentTab === 'videos'}}">
    <view class="media-card" bindtap="goToVideo">
      <view class="media-bg" style="background: linear-gradient(135deg, #9c27b0, #e040fb);"></view>
      <view class="media-content">
        <view class="media-icon">
          <van-icon name="video-o" size="40px" color="#fff" />
        </view>
        <view class="media-info">
          <text class="media-title">视频</text>
          <text class="media-desc">精彩瞬间 · 历历在目</text>
        </view>
        <view class="media-count">
          <text class="count-num">{{videoCount}}</text>
          <text class="count-unit">个视频</text>
        </view>
      </view>
      <view class="media-arrow">
        <van-icon name="arrow" size="24px" color="#fff" />
      </view>
    </view>
  </view>

  <!-- 校友会区域 -->
  <view class="content-area" wx:if="{{currentTab === 'alumni'}}">
    <!-- 各地校友会 -->
    <view class="alumni-section" wx:if="{{alumniAssociations.length > 0}}">
      <view class="alumni-section-title">🎓 各地校友会</view>
      <view class="alumni-grid">
        <view class="alumni-card" wx:for="{{alumniAssociations}}" wx:key="id">
          <view class="alumni-image">
            <view class="alumni-image-placeholder">🎓</view>
          </view>
          <view class="alumni-content">
            <view class="alumni-location-badge">📍 {{item.location}}</view>
            <view class="alumni-title">{{item.name}}</view>
            <view class="alumni-desc" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="alumni-contact">
              <view class="contact-item" wx:if="{{item.contact}}">📞 {{item.contact}}</view>
              <view class="contact-item" wx:if="{{item.wechat}}">💬 微信号：{{item.wechat}}</view>
              <view class="contact-item" wx:if="{{item.email}}">📧 邮箱：{{item.email}}</view>
              <view class="contact-item" wx:if="{{item.join_method}}">✨ {{item.join_method}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 校友会动态 -->
    <view class="alumni-section" wx:if="{{alumniNews.length > 0}}">
      <view class="alumni-section-title">📰 校友会动态</view>
      <view class="alumni-grid">
        <view class="alumni-card alumni-news-card" wx:for="{{alumniNews}}" wx:key="id" bindtap="onAlumniNewsTap" data-url="{{item.source_url}}">
          <view class="alumni-image" wx:if="{{item.image_url}}">
            <image src="{{item.image_url}}" mode="aspectFill" />
          </view>
          <view class="alumni-image" wx:else>
            <view class="alumni-image-placeholder">📰</view>
          </view>
          <view class="alumni-content">
            <view class="alumni-location" wx:if="{{item.location}}">📍 {{item.location}}</view>
            <view class="alumni-title">{{item.title}}</view>
            <view class="alumni-desc" wx:if="{{item.content}}">{{item.content}}</view>
            <view class="alumni-meta">
              <text class="alumni-date">📅 {{item.published_time}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{alumniAssociations.length === 0 && alumniNews.length === 0}}">
      <view class="empty-icon">🎓</view>
      <text>暂无校友会资讯</text>
    </view>
  </view>

  <!-- 新闻区域 -->
  <view class="content-area" wx:if="{{currentTab === 'news'}}">
    <view class="news-list" wx:if="{{news.length > 0}}">
      <view class="news-item" wx:for="{{news}}" wx:key="id" bindtap="onNewsTap" data-url="{{item.url}}">
        <image src="{{item.image}}" mode="aspectFill" class="news-image" wx:if="{{item.image}}" />
        <view class="news-info">
          <text class="news-title">{{item.title}}</text>
          <text class="news-time">{{item.time}}</text>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <view class="empty-icon">📰</view>
      <text>暂无新闻</text>
    </view>
  </view>

  <!-- 悬浮功能按钮 -->
  <view class="float-btns">
    <view class="float-btn" bindtap="toggleDarkMode">
      <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
    </view>
    <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
      <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
    </view>
  </view>
</view>

<van-toast id="van-toast" />
