.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 60rpx 30rpx 100rpx;
  position: relative;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

.header-content {
  display: flex;
  align-items: center;
}

.header-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 内容区域 */
.content-area {
  padding: 0 20rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

/* 媒体卡片 */
.media-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 0;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
  position: relative;
  display: flex;
  align-items: center;
}

.media-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  opacity: 0.9;
}

.media-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  flex: 1;
}

.media-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.media-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.media-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.media-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.media-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 24rpx;
}

.count-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.count-unit {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.media-arrow {
  padding-right: 30rpx;
}

/* 最新照片 */
.section {
  padding: 30rpx 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  color: #2c3e50;
  font-weight: bold;
  margin-left: 10rpx;
}

.photo-preview {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.photo-item {
  width: 32%;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.photo-img {
  width: 100%;
  height: 200rpx;
  display: block;
  background: #f7f8fa;
}

/* 夜间模式样式 */
.dark-mode .container {
  background: linear-gradient(180deg, #1a1a1a 0%, #2d2d2d 100%);
}

.dark-mode .header {
  background: linear-gradient(135deg, #1a1a1a, #2d2d2d) !important;
}

.dark-mode .header::after {
  background: #1a1a1a !important;
}

.dark-mode .media-card {
  background: #2d2d2d !important;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3) !important;
}

.dark-mode .section-title {
  color: #e5e5e5 !important;
}

.dark-mode .photo-item {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3) !important;
}

/* 悬浮按钮 */
.float-btns {
  position: fixed;
  right: 30rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 999;
}

.float-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dark-mode .float-btn {
  background: #2d2d2d;
}

.float-btn.music-btn {
  background: linear-gradient(135deg, #ee0a24, #ff6034);
}

.float-btn.music-btn.playing {
  animation: pulse 1.5s infinite;
}

.dark-mode .float-btn.music-btn {
  background: linear-gradient(135deg, #b8192b, #d94a2b);
}
