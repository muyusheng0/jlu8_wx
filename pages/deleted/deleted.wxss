.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 50rpx 30rpx 80rpx;
  position: relative;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 内容列表 */
.content-list {
  padding: 30rpx 20rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.item-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.item-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e74c3c, #f39c12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-type-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-type {
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
  margin-right: 12rpx;
}

.item-owner {
  font-size: 24rpx;
  color: #969799;
}

.item-time {
  font-size: 22rpx;
  color: #c8c9cc;
}

/* 内容 */
.item-content {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
  word-break: break-all;
}

/* 图片 */
.item-image {
  margin-bottom: 20rpx;
}

.preview-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* 操作按钮 */
.item-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.item-actions .van-button {
  flex: 1;
}

/* 分页 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 30rpx 0;
}

.page-info {
  font-size: 26rpx;
  color: #646566;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #969799;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #c8c9cc;
  margin-top: 8rpx;
}

.empty-state text {
  font-size: 28rpx;
}

.van-loading {
  display: flex !important;
  justify-content: center;
  padding: 100rpx 0;
}

/* 语音预览 */
.voice-preview {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.voice-preview audio {
  width: 100%;
}
