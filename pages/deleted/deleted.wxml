<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <text class="title">已删除的内容</text>
      <text class="subtitle">可恢复或彻底删除</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <van-loading wx:if="{{loading}}" vertical />

  <!-- 内容列表 -->
  <view class="content-list" wx:if="{{!loading && items.length > 0}}">
    <view class="item-card" wx:for="{{items}}" wx:key="id">
      <view class="item-header">
        <view class="item-icon">
          <van-icon wx:if="{{item.type === 'message'}}" name="comment-o" size="24px" color="#fff" />
          <van-icon wx:elif="{{item.type === 'photo'}}" name="photo-o" size="24px" color="#fff" />
          <van-icon wx:elif="{{item.type === 'video'}}" name="video-o" size="24px" color="#fff" />
          <van-icon wx:elif="{{item.type === 'comment'}}" name="chat-o" size="24px" color="#fff" />
          <van-icon wx:else name="file-o" size="24px" color="#fff" />
        </view>
        <view class="item-info">
          <view class="item-type-row">
            <text class="item-type">{{item.type === 'message' ? '留言' : item.type === 'photo' ? '照片' : item.type === 'video' ? '视频' : item.type === 'comment' ? '评论' : '其他'}}</text>
            <text class="item-owner">by {{item.owner}}</text>
          </view>
          <text class="item-time">删除于 {{item.deleted_time}}</text>
        </view>
      </view>

      <!-- 内容预览 -->
      <view class="item-content">
        <text>{{item.content || '(无内容)'}}</text>
      </view>

      <!-- 语音喊话预览 -->
      <view class="voice-preview" wx:if="{{item.type === 'voice_shout' && item.extra}}">
        <audio src="{{item.extra}}" controls />
      </view>

      <!-- 图片预览 -->
      <view class="item-image" wx:if="{{item.extra && item.type === 'message'}}">
        <image src="{{item.extra}}" mode="aspectFill" class="preview-image" bindtap="onPreviewImage" data-url="{{item.extra}}" />
      </view>

      <!-- 操作按钮 -->
      <view class="item-actions">
        <van-button size="small" round bind:click="onRestore" data-id="{{item.id}}">
          <van-icon name="replay" size="14px" /> 恢复
        </van-button>
        <van-button size="small" round type="danger" plain bind:click="onPermanentDelete" data-id="{{item.id}}">
          <van-icon name="delete-o" size="14px" /> 彻底删除
        </van-button>
      </view>
    </view>

    <!-- 分页 -->
    <view class="pagination" wx:if="{{totalPages > 1}}">
      <van-button size="small" round disabled="{{page <= 1}}" bind:click="onPrevPage">上一页</van-button>
      <text class="page-info">{{page}} / {{totalPages}}</text>
      <van-button size="small" round disabled="{{page >= totalPages}}" bind:click="onNextPage">下一页</van-button>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && items.length === 0}}" class="empty-state">
    <view class="empty-icon">🗑️</view>
    <text>暂无已删除内容</text>
  </view>
</view>

<van-toast id="van-toast" />
<van-dialog id="van-dialog" />

<!-- 悬浮功能按钮 -->
<view class="float-btns">
  <view class="float-btn" bindtap="toggleDarkMode">
    <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
  </view>
  <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
    <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
  </view>
</view>
