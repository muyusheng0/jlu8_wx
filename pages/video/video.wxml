<view class="container">
  <view class="header">
    <text class="title">视频</text>
  </view>

  <van-loading wx:if="{{loading}}" />

  <view class="video-grid" wx:if="{{!loading && videos.length > 0}}">
    <view class="video-item" wx:for="{{videos}}" wx:key="id">
      <view class="video-cover" bindtap="onPlay" data-url="{{item.url}}">
        <van-image
          src="{{item.cover || '/images/default-video.png'}}"
          fit="cover"
          width="340rpx"
          height="200rpx"
        />
        <view class="play-icon">
          <van-icon name="play-circle" size="60rpx" color="#fff" />
        </view>
        <view class="like-btn" catchtap="onLike" data-id="{{item.id}}">
          <van-icon name="{{item.liked ? 'like' : 'like-o'}}"
                    color="{{item.liked ? '#e74c3c' : '#fff'}}" />
          <text class="like-count">{{item.likeCount || 0}}</text>
        </view>
      </view>
      <view class="video-info">
        <text class="video-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <van-empty wx:if="{{!loading && videos.length === 0}}" description="暂无视频" />
</view>

<van-toast id="van-toast" />