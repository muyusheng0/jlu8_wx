<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <view class="header-icon">
        <van-icon name="video-o" size="32px" color="#fff" />
      </view>
      <view class="header-text">
        <text class="title">🎬 影像回忆</text>
        <text class="subtitle">珍藏视频，记录青春</text>
      </view>
    </view>
    <view class="upload-btn" bindtap="onUploadVideo">
      <van-icon name="plus" size="18px" color="#fff" />
      <text>上传视频</text>
    </view>
  </view>

  <van-loading wx:if="{{loading}}" vertical />

  <view class="video-list" wx:if="{{!loading && videos.length > 0}}">
    <view wx:for="{{videos}}" wx:key="id" class="video-card">
      <!-- 视频封面 -->
      <view class="video-cover" bindtap="onVideoTap" data-url="{{item.url}}" data-id="{{item.id}}">
        <video
          src="{{item.url}}"
          poster="{{item.cover}}"
          object-fit="cover"
          controls
          show-center-play-btn
          enable-play-gesture
          class="video-player"
          wx:if="{{item.playing}}"
        ></video>
        <image
          wx:else
          src="{{item.cover || '/images/default-video.png'}}"
          mode="aspectFill"
          class="video-poster"
        />
        <view class="play-overlay" wx:if="{{!item.playing}}">
          <view class="play-btn">
            <van-icon name="play" size="24px" color="#fff" />
          </view>
        </view>
        <view class="video-duration" wx:if="{{item.duration}}">{{item.duration}}</view>
        <!-- 删除按钮 -->
        <view class="delete-btn" wx:if="{{currentUser && (currentUser.name === item.owner || isAdmin)}}" catchtap="onDelete" data-id="{{item.id}}">
          <van-icon name="delete" size="18px" color="#fff" />
        </view>
      </view>

      <!-- 视频信息 -->
      <view class="video-info">
        <view class="video-main">
          <text class="video-title">{{item.title}}</text>
          <view class="video-meta">
            <van-icon name="user-o" size="12px" />
            <text>{{item.owner || '匿名'}}</text>
          </view>
        </view>
        <view class="video-actions">
          <view class="action-btn {{item.liked ? 'action-liked' : ''}}" bindtap="onLike" data-id="{{item.id}}">
            <van-icon name="{{item.liked ? 'like' : 'like-o'}}" />
            <text>{{item.likeCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && videos.length === 0}}" class="empty-state">
    <view class="empty-icon">🎬</view>
    <text>还没有视频</text>
    <text class="empty-hint">快来分享第一个吧~</text>
    <view class="empty-upload" bindtap="onUploadVideo">
      <van-icon name="plus" size="24px" />
      <text>上传视频</text>
    </view>
  </view>
</view>

<van-toast id="van-toast" />