<view class="container">
  <view class="header">
    <text class="title">视频</text>
  </view>

  <van-loading wx:if="{{loading}}" vertical />

  <van-cell-group wx:if="{{!loading && videos.length > 0}}" class="video-group">
    <van-cell
      wx:for="{{videos}}"
      wx:key="id"
      custom-class="video-cell"
    >
      <!-- 视频播放区域 -->
      <view slot="icon" class="video-cover" bindtap="onPlay" data-url="{{item.url}}">
        <video
          src="{{item.url}}"
          poster="{{item.cover || '/images/default-video.png'}}"
          object-fit="cover"
          controls
          show-center-play-btn
          enable-play-gesture
          class="video-player"
        ></video>
        <view class="play-overlay" wx:if="{{item.playing !== true}}">
          <van-icon name="play-circle" size="48rpx" color="#fff" />
        </view>
      </view>

      <!-- 视频信息 -->
      <view slot="title" class="video-content">
        <text class="video-title">{{item.title}}</text>
        <view class="video-meta">
          <text class="video-time" wx:if="{{item.created_at}}">{{item.created_at}}</text>
        </view>
      </view>

      <!-- 点赞按钮 -->
      <view slot="right-icon" class="like-wrapper" catchtap="onLike" data-id="{{item.id}}">
        <van-icon
          name="{{item.liked ? 'like' : 'like-o'}}"
          color="{{item.liked ? '#ee0a24' : '#999'}}"
          size="18px"
        />
        <text class="like-count">{{item.likeCount || 0}}</text>
      </view>
    </van-cell>
  </van-cell-group>

  <van-empty wx:if="{{!loading && videos.length === 0}}" description="暂无视频" />
</view>

<van-toast id="van-toast" />
