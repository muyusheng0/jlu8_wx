.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #9c27b0, #e040fb);
  padding: 50rpx 30rpx 30rpx;
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

.header-content {
  display: flex;
  align-items: center;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.upload-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  position: relative;
  z-index: 2;
}

/* 视频列表 */
.video-list {
  padding: 30rpx 20rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.video-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.video-cover {
  position: relative;
  width: 100%;
  height: 400rpx;
  background: #000;
}

.video-player,
.video-poster {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.play-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-btn .van-icon {
  color: #9c27b0;
  margin-left: 8rpx;
}

.video-duration {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.delete-btn {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 视频信息 */
.video-info {
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.video-main {
  flex: 1;
  min-width: 0;
}

.video-title {
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.video-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #969799;
}

.video-meta .van-icon {
  margin-right: 6rpx;
}

.video-actions {
  display: flex;
  align-items: center;
  padding-left: 24rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: #969799;
  font-size: 24rpx;
}

.action-btn .van-icon {
  font-size: 40rpx;
}

.action-liked {
  color: #ee0a24;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #969799;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #c8c9cc;
  margin-top: 8rpx;
}

.empty-state text {
  font-size: 28rpx;
}

.empty-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  padding: 40rpx 60rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.empty-upload .van-icon {
  font-size: 48rpx;
  color: #9c27b0;
  margin-bottom: 10rpx;
}

.empty-upload text {
  font-size: 26rpx;
  color: #646566;
}

.van-loading {
  display: flex !important;
  justify-content: center;
  padding: 100rpx 0;
}

/* 夜间模式样式 */
.dark-mode .container {
  background: linear-gradient(180deg, #1a1a1a 0%, #2d2d2d 100%);
}

.dark-mode .header {
  background: linear-gradient(135deg, #1a1a1a, #2d2d2d) !important;
}

.dark-mode .header::after {
  background: #1a1a1a !important;
}

.dark-mode .title,
.dark-mode .subtitle {
  color: #e5e5e5 !important;
}

.dark-mode .video-card {
  background: #2d2d2d !important;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3) !important;
}

.dark-mode .video-title {
  color: #e5e5e5 !important;
}

.dark-mode .video-meta {
  color: #888 !important;
}

.dark-mode .action-btn {
  color: #888 !important;
}

.dark-mode .empty-state {
  color: #666 !important;
}

.dark-mode .empty-upload {
  background: #2d2d2d !important;
}

.dark-mode .empty-upload text {
  color: #888 !important;
}

/* 悬浮按钮 */
.float-btns {
  position: fixed;
  right: 30rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 999;
}

.float-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dark-mode .float-btn {
  background: #2d2d2d;
}

.float-btn.music-btn {
  background: linear-gradient(135deg, #ee0a24, #ff6034);
}

.float-btn.music-btn.playing {
  animation: pulse 1.5s infinite;
}

.dark-mode .float-btn.music-btn {
  background: linear-gradient(135deg, #b8192b, #d94a2b);
}
