.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 32rpx;
  color: #2c3e50;
  font-weight: bold;
  padding-left: 20rpx;
  border-left: 4rpx solid #e74c3c;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #969799;
  font-size: 28rpx;
}

.video-group {
  margin-bottom: 20rpx;
}

.video-cell {
  padding: 20rpx !important;
  background: #fff !important;
  margin-bottom: 20rpx !important;
  border-radius: 12rpx !important;
}

.video-cover {
  position: relative;
  width: 200rpx;
  height: 120rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #000;
}

.video-player {
  width: 100%;
  height: 100%;
}

.play-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
}

.video-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.video-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.video-meta {
  margin-top: 8rpx;
}

.video-time {
  font-size: 22rpx;
  color: #999;
}

.like-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
  padding-left: 16rpx;
  border-left: 1rpx solid #eee;
}

.like-count {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}
