<view class="container">
  <van-search
    value="{{ searchKey }}"
    placeholder="搜索姓名..."
    bind:change="onSearchChange"
    bind:search="onSearch"
    shape="round"
    background="#ffffff"
    show-action="{{ searchKey }}"
    bind:clear="onClearSearch"
  />

  <van-cell-group inset class="list">
    <van-cell
      wx:for="{{ filteredStudents }}"
      wx:key="id"
      bind:click="goDetail"
      data-id="{{ item.id }}"
      center
    >
      <view slot="icon" class="avatar">{{ item.name[0] }}</view>
      <view slot="title">
        <text class="name">{{ item.name }}</text>
        <van-tag wx:if="{{ item.is_admin }}" type="danger" size="small">管理员</van-tag>
      </view>
      <view slot="label" class="location">{{ item.city || item.hometown || '未知' }}</view>
      <van-icon slot="right-icon" name="arrow" class="arrow" />
    </van-cell>
  </van-cell-group>

  <view wx:if="{{ filteredStudents.length === 0 }}" class="empty">
    <text>未找到匹配的联系人</text>
  </view>
</view>
