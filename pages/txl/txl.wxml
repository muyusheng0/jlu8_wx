<view class="container">
  <view class="search-card">
    <input class="search" placeholder="搜索姓名..." bindinput="onSearch" />
  </view>

  <view class="list">
    <view class="student-card" wx:for="{{students}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="avatar">{{item.name[0]}}</view>
      <view class="info">
        <text class="name">{{item.name}}</text>
        <text class="location">{{item.city || item.hometown}}</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>
</view>
