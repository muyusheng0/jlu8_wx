<view class="container">
  <!-- 搜索区域 -->
  <view class="search-area">
    <van-search
      value="{{ searchKey }}"
      placeholder="搜索姓名..."
      bind:change="onSearchChange"
      bind:search="onSearch"
      shape="round"
      background="#ffffff"
      show-action="{{ searchKey }}"
      bind:clear="onClearSearch"
      custom-class="search-box"
    />
  </view>

  <!-- 同学列表 -->
  <view class="student-list">
    <view wx:for="{{ filteredStudents }}" wx:key="id" class="student-card" bindtap="goDetail" data-id="{{ item.id }}">
      <view class="student-avatar" style="background: linear-gradient(135deg, {{item.avatarColor || '#2c3e50,#34495e'}})">
        {{ item.name[0] }}
      </view>
      <view class="student-info">
        <view class="student-name-row">
          <text class="student-name">{{ item.name }}</text>
          <van-tag wx:if="{{ item.is_admin }}" type="warning" size="small" class="admin-tag">管理员</van-tag>
        </view>
        <view class="student-location">
          <van-icon name="location-o" size="12px" />
          <text>{{ item.city || item.hometown || '未知' }}</text>
        </view>
        <view class="student-company" wx:if="{{item.company}}">
          <van-icon name="shop-o" size="12px" />
          <text>{{ item.company }}</text>
        </view>
      </view>
      <view class="student-arrow">
        <van-icon name="arrow" color="#c8c9cc" />
      </view>
    </view>

    <view wx:if="{{ filteredStudents.length === 0 }}" class="empty-state">
      <van-icon name="friends-o" size="60px" />
      <text>未找到匹配的联系人</text>
    </view>
  </view>

  <!-- 索引栏 -->
  <view class="index-bar">
    <view class="index-item" bindtap="scrollToIndex" data-index="A">A</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="B">B</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="C">C</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="D">D</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="F">F</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="G">G</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="H">H</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="J">J</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="L">L</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="M">M</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="N">N</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="P">P</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="Q">Q</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="S">S</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="T">T</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="W">W</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="X">X</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="Y">Y</view>
    <view class="index-item" bindtap="scrollToIndex" data-index="Z">Z</view>
  </view>
</view>
