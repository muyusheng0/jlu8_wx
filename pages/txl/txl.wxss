.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

/* 头部区域 */
.header {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 50rpx 30rpx 80rpx;
  position: relative;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.page-intro {
  text-align: center;
  padding: 16rpx 30rpx;
  background: #fff;
  margin: -20rpx 20rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 10;
}

.page-intro text {
  font-size: 24rpx;
  color: #969799;
}

.search-area {
  background: #fff;
  padding: 16rpx 20rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-box {
  border-radius: 36rpx !important;
}

/* 同学列表 */
.student-list {
  padding: 20rpx;
}

.student-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s, box-shadow 0.2s;
}

.student-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
}

.student-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.student-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.student-name {
  font-size: 32rpx;
  color: #323233;
  font-weight: 600;
}

.admin-tag {
  margin-left: 12rpx;
  background: linear-gradient(135deg, #ffd700, #ffb800) !important;
  color: #8b6914 !important;
}

.student-location,
.student-company {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #969799;
  margin-top: 6rpx;
}

.student-location .van-icon,
.student-company .van-icon {
  margin-right: 6rpx;
}

.student-location text,
.student-company text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-arrow {
  flex-shrink: 0;
  padding-left: 16rpx;
}

.student-arrow .van-icon {
  font-size: 28rpx;
}

/* 索引栏 */
.index-bar {
  position: fixed;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 24rpx;
  padding: 8rpx 4rpx;
}

.index-item {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
}

.index-item:active {
  color: #ee0a24;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #969799;
}

.empty-state .van-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-state text {
  font-size: 28rpx;
}

/* 离我最近的同学 */
.nearest-section {
  background: #fff;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
  margin-left: 10rpx;
}

.nearest-scroll {
  white-space: nowrap;
  width: 100%;
}

.nearest-list {
  display: inline-flex;
  gap: 24rpx;
  padding: 8rpx 0;
}

.nearest-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
}

.nearest-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ee0a24, #ff6034);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(238, 10, 36, 0.3);
  overflow: hidden;
}

.nearest-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.nearest-avatar text {
  z-index: 1;
}

.nearest-name {
  font-size: 26rpx;
  color: #323233;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.nearest-distance {
  font-size: 22rpx;
  color: #969799;
}
