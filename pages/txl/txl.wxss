.container {
  padding: 0;
  background: #f7f8fa;
  min-height: 100vh;
}

.list {
  margin: 20rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: linear-gradient(135deg, #2c3e50, #34495e);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.name {
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: 600;
}

.location {
  font-size: 24rpx;
  color: #969799;
  margin-top: 6rpx;
}

.arrow {
  color: #c8c9cc;
}

.empty {
  padding-top: 100rpx;
}
