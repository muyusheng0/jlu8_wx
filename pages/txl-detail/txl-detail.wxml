<view class="container">
  <van-loading wx:if="{{loading}}" />

  <block wx:if="{{student}}">
    <!-- 头像卡片 -->
    <view class="profile-card">
      <view class="avatar-wrapper">
        <view class="avatar">{{student.name[0]}}</view>
        <view class="avatar-ring"></view>
      </view>
      <text class="name">{{student.name}}</text>
      <text class="custom-intro" wx:if="{{student.custom_intro}}">"{{student.custom_intro}}"</text>
      <text class="location">{{student.hometown_name}} {{student.city}} {{student.district}}</text>
    </view>

    <!-- 联系方式 -->
    <view class="section" wx:if="{{student.phone}}">
      <van-cell-group title="联系方式">
        <van-cell title="电话" value="{{student.phone}}" is-link bind:click="showPhoneAction" />
      </van-cell-group>
    </view>

    <!-- 工作信息 -->
    <view class="section">
      <van-cell-group title="工作信息">
        <van-cell title="行业" value="{{student.industry || '未填写'}}" wx:if="{{student.industry}}" />
        <van-cell title="公司" value="{{student.company || '未填写'}}" wx:if="{{student.company}}" />
        <van-cell title="职位" value="{{student.position || '未填写'}}" wx:if="{{student.position}}" />
      </van-cell-group>
    </view>

    <!-- 个人简介 -->
    <view class="section">
      <van-cell-group title="个人简介">
        <van-cell title="爱好" value="{{student.hobby || '未填写'}}" wx:if="{{student.hobby}}" />
        <van-cell title="梦想" value="{{student.dream || '未填写'}}" wx:if="{{student.dream}}" />
      </van-cell-group>
    </view>

    <!-- 社交账号 -->
    <view class="section" wx:if="{{student.github || student.douyin || student.xiaohongshu}}">
      <van-cell-group title="社交账号">
        <van-cell title="GitHub" value="{{student.github || '未填写'}}" is-link bind:click="openLink" data-url="{{student.github}}" wx:if="{{student.github}}" />
        <van-cell title="抖音" value="{{student.douyin || '未填写'}}" is-link bind:click="openLink" data-url="{{student.douyin}}" wx:if="{{student.douyin}}" />
        <van-cell title="小红书" value="{{student.xiaohongshu || '未填写'}}" is-link bind:click="openLink" data-url="{{student.xiaohongshu}}" wx:if="{{student.xiaohongshu}}" />
      </van-cell-group>
    </view>

    <!-- 喊话区域 -->
    <view class="section voice-section">
      <van-cell-group title="喊话">
        <view class="voice-list">
          <view wx:for="{{voiceShouts}}" wx:key="id" class="voice-item">
            <view class="voice-from">{{item.from_name}}</view>
            <view class="voice-play" bindtap="playVoice" data-url="{{item.audio_url}}">
              <van-icon name="volume-o" size="20px" />
              <text>播放</text>
            </view>
            <view class="voice-time">{{item.time}}</view>
          </view>
          <view wx:if="{{voiceShouts.length === 0}}" class="voice-empty">暂无喊话记录</view>
        </view>
        <view class="voice-action">
          <van-button type="primary" size="small" round bind:click="onVoiceShout">🎤 发起喊话</van-button>
        </view>
      </van-cell-group>
    </view>

    <!-- 底部按钮 -->
    <view class="btn-group" wx:if="{{student.phone}}">
      <van-button type="primary" size="large" round bind:click="showPhoneAction">联系同学</van-button>
    </view>
  </block>
</view>

<!-- 拨号操作面板 -->
<van-action-sheet
  show="{{ showPhoneSheet }}"
  actions="{{ phoneActions }}"
  bind:close="onPhoneSheetClose"
  bind:select="onPhoneActionSelect"
  cancel-text="取消"
/>

<!-- 喊话面板 -->
<van-action-sheet
  show="{{ showVoiceSheet }}"
  title="对 {{student.name}} 喊话"
  bind:close="onVoiceSheetClose"
>
  <view class="voice-sheet-content">
    <view class="voice-tip">录制一段语音，对TA说点什么吧</view>
    <view class="voice-record-area">
      <view class="record-btn {{recording ? 'recording' : ''}}" bindtap="{{recording ? 'stopRecord' : 'startRecord'}}">
        <van-icon name="{{recording ? 'stop' : 'volume'}}" size="32px" />
        <text>{{recording ? '停止(' + recordingTime + 's)' : '录音'}}</text>
      </view>
    </view>
    <view class="voice-hint">最长5秒</view>
  </view>
</van-action-sheet>

<van-dialog id="van-dialog" />
<van-toast id="van-toast" />
