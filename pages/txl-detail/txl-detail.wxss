.container {
  padding: 30rpx;
  background: #faf8f5;
  min-height: 100vh;
}

.profile-card {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 60rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
  text-align: center;
  color: #fff;
  margin: -30rpx -30rpx 30rpx -30rpx;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e74c3c, #f39c12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 60rpx;
  font-weight: bold;
  margin: 0 auto 20rpx;
}

.name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
}

.location {
  display: block;
  font-size: 28rpx;
  margin-top: 10rpx;
  opacity: 0.8;
}

.btn-group {
  padding: 30rpx;
  margin-top: 30rpx;
}
