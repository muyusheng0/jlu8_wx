.container {
  padding: 30rpx;
  background: #faf8f5;
  min-height: 100vh;
}

.profile-card {
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  padding: 60rpx 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2c3e50, #34495e);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 72rpx;
  font-weight: bold;
  margin: 0 auto 30rpx;
}

.name {
  display: block;
  font-size: 40rpx;
  color: #2c3e50;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.location {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.info-list {
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.btn-call {
  background: linear-gradient(135deg, #e74c3c, #f39c12);
  color: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  width: 100%;
}

.btn-call::after {
  border: none;
}
