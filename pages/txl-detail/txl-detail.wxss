.container {
  padding: 0;
  background: linear-gradient(180deg, #f0f2f5 0%, #faf8f5 100%);
  min-height: 100vh;
}

.profile-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 80rpx 30rpx 60rpx;
  border-radius: 0 0 60rpx 60rpx;
  text-align: center;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.profile-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(10%, 10%); }
}

.avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 64rpx;
  font-weight: bold;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
  overflow: hidden;
}

.avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  z-index: 0;
}

.name {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.location {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
}

.custom-intro {
  display: block;
  font-size: 26rpx;
  font-style: italic;
  opacity: 0.9;
  margin: 12rpx 0;
}

.section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.btn-group {
  padding: 40rpx 60rpx;
  margin-top: 20rpx;
}

/* 喊话区域 */
.voice-section .van-cell-group {
  border-radius: 16rpx;
  overflow: hidden;
}

.voice-list {
  padding: 20rpx;
}

.voice-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.voice-item:last-child {
  border-bottom: none;
}

.voice-from {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
  min-width: 120rpx;
}

.voice-play {
  flex: 1;
  display: flex;
  align-items: center;
  color: #ee0a24;
  font-size: 26rpx;
}

.voice-play text {
  margin-left: 8rpx;
}

.voice-time {
  font-size: 22rpx;
  color: #969799;
}

.voice-empty {
  text-align: center;
  padding: 30rpx 0;
  color: #969799;
  font-size: 26rpx;
}

.voice-action {
  padding: 20rpx;
  text-align: center;
}

/* 喊话面板 */
.voice-sheet-content {
  padding: 40rpx 30rpx;
  text-align: center;
}

.voice-tip {
  font-size: 28rpx;
  color: #646566;
  margin-bottom: 30rpx;
}

.voice-record-area {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.record-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ee0a24, #ff6034);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(238, 10, 36, 0.3);
}

.record-btn.recording {
  background: linear-gradient(135deg, #999, #666);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.record-btn text {
  margin-top: 10rpx;
}

.voice-hint {
  font-size: 22rpx;
  color: #969799;
}
