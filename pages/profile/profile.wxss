.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

/* 头像卡片 */
.profile-card {
  background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
  padding: 80rpx 40rpx 100rpx;
  text-align: center;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.card-wave {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

.avatar-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 20rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 64rpx;
  font-weight: bold;
  margin: 0 auto;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.edit-avatar-btn {
  position: absolute;
  bottom: 0;
  right: -10rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6034, #ee0a24);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(238, 10, 36, 0.4);
}

.name {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.student-id {
  display: block;
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.7;
}

.location-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.location {
  font-size: 26rpx;
  opacity: 0.8;
  margin-left: 6rpx;
}

.gps-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
}

.gps-text {
  font-size: 24rpx;
  opacity: 0.7;
  margin-left: 6rpx;
}

.custom-intro {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-style: italic;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #ee0a24;
  color: #fff;
  font-size: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

/* 快捷操作 */
.quick-actions {
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.action-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.action-text {
  flex: 1;
  font-size: 30rpx;
  color: #323233;
  font-weight: 500;
}

/* 分区 */
.section {
  margin: 24rpx 24rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-title {
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: bold;
  margin-left: 10rpx;
}

.section-hint {
  font-size: 22rpx;
  color: #969799;
  margin-left: auto;
}

.section .van-cell-group {
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section .van-cell {
  padding: 32rpx 28rpx;
}

/* 按钮区域 */
.btn-section {
  padding: 48rpx 32rpx;
}

.edit-btn {
  background: linear-gradient(135deg, #ff6034, #ee0a24) !important;
  border: none !important;
  font-weight: bold;
}

.logout-btn {
  margin-top: 24rpx;
  color: #969799 !important;
}

/* 弹窗样式 */
.edit-popup {
  max-height: 85vh !important;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-cancel {
  font-size: 28rpx;
  color: #969799;
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
}

.popup-save {
  font-size: 28rpx;
  color: #ee0a24;
  font-weight: bold;
}

.popup-content {
  max-height: 60vh;
  padding: 16rpx 0;
}

.popup-content .van-cell {
  padding: 28rpx 32rpx;
}

.popup-content .van-field {
  padding: 20rpx 32rpx;
}

.popup-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.save-btn {
  background: linear-gradient(135deg, #ff6034, #ee0a24) !important;
  border: none !important;
  font-weight: bold;
}

/* van-field 错误状态 */
.van-field__error-message {
  color: #ee0a24;
}

/* 加载状态 */
.van-loading {
  display: flex !important;
  justify-content: center;
  align-items: center;
  padding-top: 200rpx;
}

/* 关于我们 */
.about-section {
  margin: 24rpx;
}

.about-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.about-text {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
  display: block;
}

.about-footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.about-footer text {
  font-size: 24rpx;
  color: #969799;
}

/* 夜间模式样式 */
.dark-mode .container {
  background: linear-gradient(180deg, #1a1a1a 0%, #2d2d2d 100%);
}

.dark-mode .profile-card {
  background: linear-gradient(135deg, #1a1a1a, #2d2d2d) !important;
}

.dark-mode .card-wave {
  background: #1a1a1a !important;
}

.dark-mode .action-item {
  background: #2d2d2d !important;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3) !important;
}

.dark-mode .action-text {
  color: #e5e5e5 !important;
}

.dark-mode .section-title {
  color: #e5e5e5 !important;
}

.dark-mode .section .van-cell-group {
  background: #2d2d2d !important;
}

.dark-mode .about-content {
  background: #2d2d2d !important;
}

.dark-mode .about-text {
  color: #888 !important;
}

.dark-mode .about-footer {
  border-top-color: #3d3d3d !important;
}

.dark-mode .about-footer text {
  color: #666 !important;
}

.dark-mode .logout-btn {
  color: #888 !important;
}

/* 悬浮按钮 */
.float-btns {
  position: fixed;
  right: 30rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 999;
}

.float-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dark-mode .float-btn {
  background: #2d2d2d;
}

.float-btn.music-btn {
  background: linear-gradient(135deg, #ee0a24, #ff6034);
}

.float-btn.music-btn.playing {
  animation: pulse 1.5s infinite;
}

.dark-mode .float-btn.music-btn {
  background: linear-gradient(135deg, #b8192b, #d94a2b);
}
