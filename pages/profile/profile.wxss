.container {
  padding: 30rpx;
  background: #faf8f5;
  min-height: 100vh;
}

.profile-card {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 60rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
  text-align: center;
  color: #fff;
  margin: -30rpx -30rpx 30rpx -30rpx;
  padding-top: 80rpx;
  padding-bottom: 80rpx;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e74c3c, #f39c12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 60rpx;
  font-weight: bold;
  margin: 0 auto 20rpx;
}

.name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-top: 20rpx;
}

.info {
  display: block;
  font-size: 28rpx;
  margin-top: 10rpx;
  opacity: 0.8;
}

.info-list {
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  overflow: hidden;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1px solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.logout-btn {
  background: linear-gradient(135deg, #e74c3c, #f39c12);
  color: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  width: 100%;
  border: none;
}

.logout-btn::after {
  border: none;
}

.btn-group {
  padding: 30rpx;
  margin-top: 30rpx;
}

.edit-popup {
  background: #fff;
  min-height: 600rpx;
}

.edit-header {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1px solid #eee;
}

.edit-title {
  font-size: 32rpx;
  font-weight: bold;
}
