<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <van-loading wx:if="{{loading}}" vertical />

  <block wx:if="{{!loading && profile}}">
    <!-- 头像卡片 -->
    <view class="profile-card">
      <view class="card-wave"></view>
      <view class="avatar-wrap">
        <view class="avatar" style="background: linear-gradient(135deg, {{avatarColor}});">
          <image wx:if="{{profile.avatar}}" src="{{profile.avatar}}" class="avatar-img" />
          <text wx:else>{{profile.name[0]}}</text>
        </view>
        <view class="edit-avatar-btn" bindtap="onUploadAvatar">
          <van-icon name="edit" size="24rpx" color="#fff" />
        </view>
      </view>
      <text class="name">{{profile.name}}</text>
      <text class="student-id">学号: {{profile.id}}</text>
      <view class="location-wrap" wx:if="{{profile.city || profile.hometown_name}}">
        <van-icon name="location-o" size="22rpx" color="rgba(255,255,255,0.8)" />
        <text class="location">{{profile.city || profile.hometown_name}}</text>
      </view>
      <!-- GPS位置 -->
      <view class="gps-wrap" wx:if="{{profile.gps_coords}}">
        <van-icon name="location-o" size="22rpx" color="rgba(255,255,255,0.8)" />
        <text class="gps-text">{{profile.gps_coords}}</text>
      </view>
      <!-- 个性签名 -->
      <view class="custom-intro" wx:if="{{profile.custom_intro}}">
        <text>{{profile.custom_intro}}</text>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions">
      <view class="action-item" bindtap="goToNotifications">
        <view class="action-icon" style="background: linear-gradient(135deg, #e74c3c, #f39c12);">
          <van-icon name="bell" size="24px" color="#fff" />
          <view class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
        </view>
        <text class="action-text">消息通知</text>
        <van-icon name="arrow" size="14px" color="#c8c9cc" />
      </view>
      <view class="action-item" bindtap="goToDeleted">
        <view class="action-icon" style="background: linear-gradient(135deg, #969799, #787878);">
          <van-icon name="delete-o" size="24px" color="#fff" />
        </view>
        <text class="action-text">已删除内容</text>
        <van-icon name="arrow" size="14px" color="#c8c9cc" />
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="section">
      <view class="section-header">
        <van-icon name="user-o" size="18px" color="#ee0a24" />
        <text class="section-title">基本信息</text>
      </view>
      <van-cell-group border="{{false}}" inset>
        <van-cell title="性别" value="{{profile.gender || '未填写'}}" is-link bind:click="onEdit" data-field="gender" />
        <van-cell title="生日" value="{{profile.birthday || '未填写'}}" is-link bind:click="onEdit" data-field="birthday" />
        <van-cell title="联系电话" value="{{profile.phone || '未填写'}}" is-link bind:click="onEdit" data-field="phone" />
        <van-cell title="电子邮箱" value="{{profile.email || '未填写'}}" is-link bind:click="onEdit" data-field="email" />
        <van-cell title="QQ号" value="{{profile.qq || '未填写'}}" is-link bind:click="onEdit" data-field="qq" />
        <van-cell title="当前所在地" value="{{profile.city || profile.hometown_name || '未填写'}}" is-link bind:click="onEdit" data-field="city" />
      </van-cell-group>
    </view>

    <!-- 社交媒体 -->
    <view class="section">
      <view class="section-header">
        <van-icon name="share" size="18px" color="#ee0a24" />
        <text class="section-title">社交媒体</text>
        <text class="section-hint">通讯录可见</text>
      </view>
      <van-cell-group border="{{false}}" inset>
        <van-cell title="GitHub" value="{{profile.github || '未填写'}}" is-link bind:click="onEdit" data-field="github" />
        <van-cell title="抖音" value="{{profile.douyin || '未填写'}}" is-link bind:click="onEdit" data-field="douyin" />
        <van-cell title="小红书" value="{{profile.xiaohongshu || '未填写'}}" is-link bind:click="onEdit" data-field="xiaohongshu" />
      </van-cell-group>
    </view>

    <!-- 工作信息 -->
    <view class="section">
      <view class="section-header">
        <van-icon name="bag-o" size="18px" color="#ee0a24" />
        <text class="section-title">工作信息</text>
      </view>
      <van-cell-group border="{{false}}" inset>
        <van-cell title="从事行业" value="{{profile.industry || '未填写'}}" is-link bind:click="onEdit" data-field="industry" />
        <van-cell title="工作单位" value="{{profile.company || '未填写'}}" is-link bind:click="onEdit" data-field="company" />
        <van-cell title="职位" value="{{profile.position || '未填写'}}" is-link bind:click="onEdit" data-field="position" />
      </van-cell-group>
    </view>

    <!-- 个人兴趣 -->
    <view class="section">
      <view class="section-header">
        <van-icon name="star-o" size="18px" color="#ee0a24" />
        <text class="section-title">个人兴趣</text>
      </view>
      <van-cell-group border="{{false}}" inset>
        <van-cell title="兴趣爱好" value="{{profile.hobby || '未填写'}}" is-link bind:click="onEdit" data-field="hobby" />
        <van-cell title="梦想" value="{{profile.dream || '未填写'}}" is-link bind:click="onEdit" data-field="dream" />
      </van-cell-group>
    </view>

    <!-- 管理员功能 (仅管理员可见) -->
    <view class="section" wx:if="{{profile.is_admin || profile.is_super_admin}}">
      <view class="section-header">
        <van-icon name="setting" size="18px" color="#ee0a24" />
        <text class="section-title">管理功能</text>
      </view>
      <van-cell-group border="{{false}}" inset>
        <van-cell title="动态管理" is-link bind:click="goToActivityAdmin">
          <van-icon slot="icon" name="orders-o" size="18px" color="#ee0a24" />
        </van-cell>
        <van-cell title="登录日志" is-link bind:click="goToLoginLogs">
          <van-icon slot="icon" name="log" size="18px" color="#ee0a24" />
        </van-cell>
      </van-cell-group>
    </view>

    <!-- 超级管理员功能 -->
    <view class="section" wx:if="{{profile.is_super_admin}}">
      <van-cell-group border="{{false}}" inset>
        <van-cell title="管理员设置" is-link bind:click="goToAdminSettings">
          <van-icon slot="icon" name="shield-o" size="18px" color="#ee0a24" />
        </van-cell>
        <van-cell title="新闻爬取设置" is-link bind:click="goToNewsConfig">
          <van-icon slot="icon" name="newspaper-o" size="18px" color="#ee0a24" />
        </van-cell>
      </van-cell-group>
    </view>

    <!-- 操作按钮 -->
    <view class="btn-section">
      <van-button type="primary" block round bind:click="onEdit" custom-class="edit-btn">
        <van-icon name="edit" style="margin-right: 8rpx;" />编辑资料
      </van-button>
      <van-button plain hairline type="default" block round bind:click="onLogout" custom-class="logout-btn">
        退出登录
      </van-button>
    </view>
  </block>

  <!-- 编辑弹窗 -->
  <van-popup show="{{showEdit}}" position="bottom" round custom-class="edit-popup">
    <view class="popup-header">
      <text class="popup-cancel" bindtap="onCancel">取消</text>
      <text class="popup-title">编辑资料</text>
      <text class="popup-save" bindtap="onSave">保存</text>
    </view>

    <scroll-view scroll-y class="popup-content">
      <van-cell-group border="{{false}}">
        <van-field
          label="个性签名"
          value="{{editForm.custom_intro}}"
          data-field="custom_intro"
          bind:change="onEditField"
          placeholder="一句话介绍自己"
        />
        <van-field
          label="性别"
          value="{{editForm.gender}}"
          data-field="gender"
          bind:change="onEditField"
          placeholder="男/女"
        />
        <van-field
          label="生日"
          value="{{editForm.birthday}}"
          data-field="birthday"
          bind:change="onEditField"
          placeholder="YYYY-MM-DD"
        />
        <van-field
          label="联系电话"
          value="{{editForm.phone}}"
          data-field="phone"
          bind:change="onEditField"
          placeholder="请输入手机号"
          type="number"
          maxlength="11"
          error="{{errors.phone}}"
        />
        <van-field
          label="电子邮箱"
          value="{{editForm.email}}"
          data-field="email"
          bind:change="onEditField"
          placeholder="请输入邮箱"
          type="text"
        />
        <van-field
          label="QQ号"
          value="{{editForm.qq}}"
          data-field="qq"
          bind:change="onEditField"
          placeholder="请输入QQ号"
          type="number"
        />
        <van-field
          label="从事行业"
          value="{{editForm.industry}}"
          data-field="industry"
          bind:change="onEditField"
          placeholder="请输入行业"
        />
        <van-field
          label="工作单位"
          value="{{editForm.company}}"
          data-field="company"
          bind:change="onEditField"
          placeholder="请输入公司名称"
        />
        <van-field
          label="职位"
          value="{{editForm.position}}"
          data-field="position"
          bind:change="onEditField"
          placeholder="请输入职位"
        />
        <van-field
          label="兴趣爱好"
          value="{{editForm.hobby}}"
          data-field="hobby"
          bind:change="onEditField"
          placeholder="请输入兴趣爱好"
        />
        <van-field
          label="梦想"
          value="{{editForm.dream}}"
          data-field="dream"
          bind:change="onEditField"
          placeholder="请输入你的梦想"
        />
        <van-field
          label="GitHub"
          value="{{editForm.github}}"
          data-field="github"
          bind:change="onEditField"
          placeholder="GitHub主页链接"
        />
        <van-field
          label="抖音"
          value="{{editForm.douyin}}"
          data-field="douyin"
          bind:change="onEditField"
          placeholder="抖音主页链接"
        />
        <van-field
          label="小红书"
          value="{{editForm.xiaohongshu}}"
          data-field="xiaohongshu"
          bind:change="onEditField"
          placeholder="小红书主页链接"
        />
      </van-cell-group>
    </scroll-view>

    <view class="popup-footer">
      <van-button type="primary" block round bind:click="onSave" custom-class="save-btn">
        保存修改
      </van-button>
    </view>
  </van-popup>

  <!-- 关于我们 -->
  <view class="section about-section">
    <view class="section-header">
      <van-icon name="info-o" size="18px" color="#ee0a24" />
      <text class="section-title">关于我们</text>
    </view>
    <view class="about-content">
      <text class="about-text">吉大自动化八班，一个由32位同学组成的大家庭。我们相识于2015年那个金秋，在吉林大学南岭校区自动化专业共同度过了四年的大学时光。</text>
      <view class="about-footer">
        <text>吉大自动化八班 © 2026</text>
        <text>青春不散场，友谊永长存</text>
      </view>
    </view>
  </view>

  <!-- 悬浮功能按钮 -->
  <view class="float-btns">
    <view class="float-btn" bindtap="toggleDarkMode">
      <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
    </view>
    <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
      <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
    </view>
  </view>
</view>

<van-toast id="van-toast" />