<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <van-loading wx:if="{{loading}}" vertical />

  <view class="page-header">
    <van-icon name="log" size="24px" color="#ee0a24" />
    <text class="page-title">登录日志</text>
  </view>

  <view class="log-list" wx:if="{{!loading && logs.length > 0}}">
    <van-cell-group border="{{false}}" inset>
      <van-cell wx:for="{{logs}}" wx:key="id" title="{{item.name}}" label="{{item.ip}} - {{item.location}}">
        <view slot="right-icon" class="log-time">{{formatTime(item.login_time)}}</view>
      </van-cell>
    </van-cell-group>
  </view>

  <view class="empty-state" wx:if="{{!loading && logs.length === 0}}">
    <view class="empty-icon">🔐</view>
    <text>暂无登录记录</text>
  </view>

  <!-- 悬浮功能按钮 -->
  <view class="float-btns">
    <view class="float-btn" bindtap="toggleDarkMode">
      <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
    </view>
    <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
      <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
    </view>
  </view>
</view>