.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-left: 12rpx;
  color: #2c3e50;
}

.log-list {
  padding: 20rpx 0;
}

.log-time {
  font-size: 22rpx;
  color: #969799;
  margin-top: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #c8c9cc;
  font-size: 28rpx;
}