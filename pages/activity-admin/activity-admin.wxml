<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <van-loading wx:if="{{loading}}" vertical />

  <view class="page-header">
    <van-icon name="orders-o" size="24px" color="#ee0a24" />
    <text class="page-title">动态管理</text>
  </view>

  <view class="activity-list" wx:if="{{!loading && activities.length > 0}}">
    <view class="activity-item" wx:for="{{activities}}" wx:key="id">
      <view class="activity-header">
        <text class="activity-user">{{item.user_name}}</text>
        <text class="activity-time">{{formatTime(item.created_at)}}</text>
      </view>
      <view class="activity-content">{{item.description}}</view>
      <view class="activity-actions">
        <van-button size="small" type="danger" plain hairline catchtap="onDelete" data-time="{{item.time}}" data-actor="{{item.actor}}">删除</van-button>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && activities.length === 0}}">
    <view class="empty-icon">📋</view>
    <text>暂无动态</text>
  </view>

  <!-- 悬浮功能按钮 -->
  <view class="float-btns">
    <view class="float-btn" bindtap="toggleDarkMode">
      <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
    </view>
    <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
      <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
    </view>
  </view>
</view>