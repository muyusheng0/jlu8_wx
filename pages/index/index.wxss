.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

/* 头部区域 */
.header {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 60rpx 30rpx 100rpx;
  position: relative;
  overflow: hidden;
}

.header-content {
  position: relative;
  z-index: 2;
}

.logo-area {
  display: flex;
  align-items: center;
}

.logo-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff6034, #ee0a24);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(238, 10, 36, 0.3);
}

.logo-text {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.header-wave {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

/* 统计卡片 */
.stats-section {
  padding: 0 30rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 3;
}

.stats-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #ee0a24;
  line-height: 1.2;
}

.stats-label {
  font-size: 24rpx;
  color: #969799;
  margin-top: 8rpx;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: #ebedf0;
}

/* 功能入口 */
.menu-section {
  padding: 40rpx 30rpx 20rpx;
}

.menu-grid {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.menu-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.menu-text {
  font-size: 26rpx;
  color: #646566;
  font-weight: 500;
}

/* 内容区块 */
.section {
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-title {
  font-size: 34rpx;
  color: #2c3e50;
  font-weight: bold;
  margin-left: 10rpx;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #969799;
}

/* 最新动态轮播 */
.activity-swiper {
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.activity-card {
  height: 200rpx;
  background: linear-gradient(135deg, #2c3e50, #34495e);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.activity-card.birthday {
  background: linear-gradient(135deg, #ff6034, #ee0a24);
}

.activity-card.message {
  background: linear-gradient(135deg, #07c160, #10b981);
}

.activity-card.photo {
  background: linear-gradient(135deg, #9c27b0, #e040fb);
}

.activity-card.video {
  background: linear-gradient(135deg, #00bcd4, #0097a7);
}

.activity-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.activity-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  color: #fff;
}

.activity-actor {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.activity-text {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-time {
  font-size: 22rpx;
  opacity: 0.7;
}

/* 轮播指示器 */
.swiper-indicators {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
}

.indicator {
  width: 16rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d0d0d0;
  transition: all 0.3s;
}

.indicator.active {
  width: 32rpx;
  background: #ee0a24;
}

/* 班级时光时间线 */
.timeline {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.timeline-item {
  display: flex;
  padding-bottom: 30rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6034, #ee0a24);
  flex-shrink: 0;
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background: linear-gradient(180deg, #ff6034, #ebedf0);
  margin-top: 8rpx;
}

.timeline-content {
  flex: 1;
  padding-bottom: 10rpx;
}

.timeline-year {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.timeline-event {
  display: block;
  font-size: 26rpx;
  color: #646566;
  line-height: 1.6;
}

/* 留言卡片 */
.message-card {
  border-radius: 16rpx !important;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06) !important;
  margin-bottom: 20rpx !important;
}

.message-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.message-time {
  font-size: 22rpx;
  color: #969799;
}

.message-content {
  display: block;
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
  margin-top: 12rpx;
}

.message-footer {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #969799;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #969799;
}

.empty-state .van-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-state text {
  font-size: 28rpx;
}
