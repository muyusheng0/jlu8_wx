<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <!-- 头部区域 -->
  <view class="header">
    <view class="header-content">
      <view class="logo-area">
        <view class="logo-icon">📖</view>
        <view class="logo-text">
          <text class="title">吉大自动化八班</text>
          <text class="subtitle">时光不老 · 我们不散</text>
        </view>
      </view>
    </view>
    <view class="header-wave"></view>
  </view>

  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">同学录</text>
    <text class="page-subtitle">珍藏回忆，联络你我</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stats-card">
      <view class="stats-item">
        <text class="stats-num">{{studentCount}}</text>
        <text class="stats-label">同学总数</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-num">{{messageCount}}</text>
        <text class="stats-label">留言总数</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-num">{{photoCount}}</text>
        <text class="stats-label">照片总数</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="menu-grid">
      <view class="menu-item" bindtap="goToTXL">
        <view class="menu-icon bg-gradient-warm">
          <van-icon name="friends-o" size="28px" color="#fff" />
        </view>
        <text class="menu-text">通讯录</text>
      </view>
      <view class="menu-item" bindtap="goToLYB">
        <view class="menu-icon bg-gradient-green">
          <van-icon name="comment-o" size="28px" color="#fff" />
        </view>
        <text class="menu-text">留言板</text>
      </view>
      <view class="menu-item" bindtap="goToGallery">
        <view class="menu-icon bg-gradient-dark">
          <van-icon name="photo-o" size="28px" color="#fff" />
        </view>
        <text class="menu-text">相册</text>
      </view>
      <view class="menu-item" bindtap="goToVideo">
        <view class="menu-icon" style="background: linear-gradient(135deg, #9c27b0, #e040fb);">
          <van-icon name="video-o" size="28px" color="#fff" />
        </view>
        <text class="menu-text">视频</text>
      </view>
    </view>
  </view>

  <!-- 最新动态 -->
  <view class="section" wx:if="{{activities.length > 0}}">
    <view class="section-header">
      <view class="section-title-wrap">
        <van-icon name="clock" size="18px" color="#ee0a24" />
        <text class="section-title">最新动态</text>
        <view class="unread-badge" wx:if="{{unreadActivityCount > 0}}">{{unreadActivityCount > 99 ? '99+' : unreadActivityCount}}</view>
      </view>
    </view>
    <view class="section-hint">👇 点击卡片查看详情</view>

    <!-- 轮播 -->
    <swiper class="activity-swiper" autoplay interval="4000" circular bindchange="onSwiperChange">
      <swiper-item wx:for="{{activities}}" wx:key="index">
        <view class="activity-card {{item.type}}" bindtap="onActivityTap" data-index="{{index}}">
          <view class="activity-icon">
            <van-icon wx:if="{{item.type === 'birthday'}}" name="cake" size="32px" color="#fff" />
            <van-icon wx:elif="{{item.type === 'message'}}" name="comment-o" size="32px" color="#fff" />
            <van-icon wx:elif="{{item.type === 'photo'}}" name="photo-o" size="32px" color="#fff" />
            <van-icon wx:elif="{{item.type === 'video'}}" name="video-o" size="32px" color="#fff" />
            <van-icon wx:elif="{{item.type === 'voice_shout'}}" name="volume-o" size="32px" color="#fff" />
            <van-icon wx:else name="star-o" size="32px" color="#fff" />
          </view>
          <view class="activity-content">
            <text class="activity-actor">{{item.actor}}</text>
            <text class="activity-text">{{item.content}}</text>
            <text class="activity-time">{{item.time}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 指示器 -->
    <view class="swiper-indicators">
      <view wx:for="{{activities}}" wx:key="index" class="indicator {{currentSwiper === index ? 'active' : ''}}"></view>
    </view>
  </view>

  <!-- 我们的时光 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <van-icon name="clock" size="18px" color="#ee0a24" />
        <text class="section-title">我们的时光</text>
      </view>
    </view>
    <view class="section-hint">👆 可在媒体相册中上传照片</view>

    <view class="timeline">
      <view class="timeline-item" wx:for="{{timeline}}" wx:key="index">
        <view class="timeline-marker">
          <view class="timeline-dot"></view>
          <view class="timeline-line" wx:if="{{index < timeline.length - 1}}"></view>
        </view>
        <view class="timeline-content">
          <text class="timeline-year">{{item.year}}</text>
          <text class="timeline-event">{{item.event}}</text>
          <!-- 照片 -->
          <view class="timeline-photos" wx:if="{{item.photos && item.photos.length > 0}}">
            <image
              wx:for="{{item.photos}}"
              wx:key="id"
              src="{{item.url}}"
              mode="aspectFill"
              class="timeline-photo"
              bindtap="previewPhoto"
              data-url="{{item.url}}"
              data-urls="{{getPhotoUrls(item.photos)}}"
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮功能按钮 -->
  <view class="float-btns">
    <!-- 夜间模式切换 -->
    <view class="float-btn" bindtap="toggleDarkMode">
      <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
    </view>
    <!-- 音乐播放按钮 -->
    <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
      <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
    </view>
  </view>
</view>

<van-toast id="van-toast" />
