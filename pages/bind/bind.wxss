.container {
  padding: 100rpx 50rpx;
  background: #faf8f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  color: #2c3e50;
  font-weight: bold;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 16rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  padding: 50rpx 30rpx;
}

.input {
  background: #faf8f5;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}

.input:focus {
  border-color: #e74c3c;
  outline: none;
}

.btn {
  background: linear-gradient(135deg, #e74c3c, #f39c12);
  color: #fff;
  border-radius: 8rpx;
  padding: 26rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
  border: none;
}

.btn::after {
  border: none;
}
