.container {
  padding: 30rpx;
  background: #faf8f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 32rpx;
  color: #2c3e50;
  font-weight: bold;
  padding-left: 20rpx;
  border-left: 4rpx solid #e74c3c;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.photo-item {
  width: 48%;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  overflow: hidden;
}

.photo-item:active {
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.15);
}

.photo-image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx 8rpx 0 0;
}

.photo-wrapper {
  position: relative;
}

.like-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #fff;
  font-size: 22rpx;
}

.photo-info {
  padding: 16rpx;
}

.photo-title {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
