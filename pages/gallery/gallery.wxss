.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 50rpx 30rpx 80rpx;
  position: relative;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

.title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.content-area {
  padding: 30rpx 20rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.photo-item {
  width: 49%;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.photo-wrapper {
  position: relative;
  width: 100%;
}

.photo-image {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #f7f8fa;
}

/* 图片遮罩层 */
.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 16rpx 16rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
}

/* 点赞按钮 */
.like-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #fff;
  font-size: 24rpx;
}

.like-btn.liked {
  background: linear-gradient(135deg, #ee0a24, #ff6034);
}

.like-count {
  font-weight: 500;
  min-width: 24rpx;
  text-align: center;
}

/* 图片信息 */
.photo-info {
  padding: 16rpx 20rpx 20rpx;
}

.photo-owner {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #969799;
}

.photo-owner .van-icon {
  margin-right: 6rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #969799;
}

.empty-state .van-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-state text {
  font-size: 28rpx;
}

.van-loading {
  display: flex !important;
  justify-content: center;
  padding: 100rpx 0;
}
