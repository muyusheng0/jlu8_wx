.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 50rpx 30rpx 30rpx;
  position: relative;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

.header-content {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.photo-count {
  text-align: center;
  padding: 16rpx 30rpx;
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.photo-count text {
  font-size: 26rpx;
  color: #969799;
}

.upload-tip {
  text-align: center;
  font-size: 24rpx;
  color: #969799;
  padding: 16rpx 30rpx;
  margin: 0 20rpx;
}

.upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #ff6034, #ee0a24);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(238, 10, 36, 0.3);
}

.content-area {
  padding: 30rpx 20rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx;
}

.photo-item {
  width: 49%;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.photo-wrapper {
  position: relative;
  width: 100%;
}

.photo-image {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #f7f8fa;
}

/* 照片悬浮层 */
.photo-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, transparent 40%, transparent 60%, rgba(0,0,0,0.3) 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.photo-wrapper:active .photo-overlay,
.photo-wrapper:hover .photo-overlay {
  opacity: 1;
}

.overlay-top {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  display: flex;
  justify-content: space-between;
}

.overlay-bottom {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  right: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.action-btns {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 点赞按钮 */
.like-btn {
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #fff;
  font-size: 24rpx;
}

.like-btn.liked {
  background: linear-gradient(135deg, #ee0a24, #ff6034);
}

.like-count {
  font-weight: 500;
  min-width: 24rpx;
  text-align: center;
}

/* 图片信息 */
.photo-info {
  padding: 16rpx 20rpx 20rpx;
}

.photo-owner {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #969799;
}

.photo-owner .van-icon {
  margin-right: 6rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #969799;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #c8c9cc;
  margin-top: 8rpx;
}

.empty-state text {
  font-size: 28rpx;
}

.empty-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  padding: 40rpx 60rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.empty-upload .van-icon {
  font-size: 48rpx;
  color: #ee0a24;
  margin-bottom: 10rpx;
}

.empty-upload text {
  font-size: 26rpx;
  color: #646566;
}

.van-loading {
  display: flex !important;
  justify-content: center;
  padding: 100rpx 0;
}
