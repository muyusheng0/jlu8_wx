<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <text class="title">📷 青春相册</text>
      <text class="subtitle">记录美好瞬间，定格永恒回忆</text>
    </view>
    <view class="upload-btn" bindtap="onUploadPhoto">
      <van-icon name="photograph" size="20px" color="#fff" />
      <text>上传照片</text>
    </view>
  </view>

  <van-loading wx:if="{{loading}}" vertical />

  <view class="upload-tip" wx:if="{{!loading && photos.length > 0}}">上传照片需验证身份</view>

  <view class="photo-grid" wx:if="{{!loading && photos.length > 0}}">
    <view class="photo-item" wx:for="{{photos}}" wx:key="id">
      <view class="photo-wrapper" bindtap="onPreview" data-url="{{item.url}}" data-urls="{{previewUrls}}">
        <image
          src="{{item.url}}"
          mode="aspectFill"
          class="photo-image"
          lazy-load
        />
        <view class="photo-overlay">
          <view class="overlay-top">
            <view class="like-btn" catchtap="onLike" data-id="{{item.id}}">
              <van-icon name="{{item.liked ? 'like' : 'like-o'}}"
                        color="{{item.liked ? '#ee0a24' : '#fff'}}"
                        size="18px" />
              <text class="like-count">{{item.likeCount || 0}}</text>
            </view>
          </view>
          <view class="overlay-bottom">
            <view class="action-btns">
              <view class="action-btn" catchtap="onSaveImage" data-url="{{item.url}}">
                <van-icon name="down" size="16px" color="#fff" />
              </view>
              <view class="action-btn" wx:if="{{currentUser && (currentUser.name === item.owner || isAdmin)}}" catchtap="onDelete" data-id="{{item.id}}">
                <van-icon name="delete" size="16px" color="#fff" />
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="photo-info">
        <view class="photo-owner">
          <van-icon name="user-o" size="12px" />
          <text>{{item.owner || '匿名'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && photos.length === 0}}" class="empty-state">
    <view class="empty-icon">📷</view>
    <text>还没有上传照片</text>
    <text class="empty-hint">快来分享你的第一张吧~</text>
    <view class="empty-upload" bindtap="onUploadPhoto">
      <van-icon name="plus" size="24px" />
      <text>上传照片</text>
    </view>
  </view>

  <!-- 悬浮功能按钮 -->
  <view class="float-btns">
    <view class="float-btn" bindtap="toggleDarkMode">
      <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
    </view>
    <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
      <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
    </view>
  </view>
</view>

<van-toast id="van-toast" />