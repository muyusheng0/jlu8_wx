<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <text class="title">💬 留言板</text>
      <text class="subtitle">留下你的足迹，分享你的故事</text>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-header">
      <van-icon name="edit" size="18px" color="#ee0a24" />
      <text class="input-title">发表留言</text>
    </view>
    <van-field
      value="{{newContent}}"
      placeholder="写下想说的话..."
      bind:change="onContentInput"
      type="textarea"
      autosize
      border="{{false}}"
      show-confirm-bar="{{false}}"
      class="input-field"
      maxlength="500"
    />

    <!-- 已选择的图片预览 -->
    <view class="image-preview" wx:if="{{newImageUrl}}">
      <image src="{{newImageUrl}}" mode="aspectFill" />
      <view class="remove-image" bindtap="onRemoveImage">
        <van-icon name="cross" size="14px" color="#fff" />
      </view>
    </view>

    <!-- 录音状态显示 -->
    <view class="recording-status" wx:if="{{isRecording}}">
      <view class="recording-indicator"></view>
      <text>录音中... {{recordingDuration}}秒</text>
      <text class="recording-tip">点击"停止"发送</text>
    </view>

    <view class="input-footer">
      <view class="input-actions">
        <view class="action-btn" bindtap="onChooseImage">
          <van-icon name="photograph" size="20px" color="#969799" />
        </view>
        <!-- 录音按钮 -->
        <view class="voice-record-btn {{isRecording ? 'recording' : ''}}" bindtap="onStartRecord" wx:if="{{!isRecording}}">
          <van-icon name="audio" size="20px" color="#969799" />
        </view>
        <view class="voice-record-btn recording" bindtap="onStopRecord" wx:if="{{isRecording}}">
          <van-icon name="stop-circle" size="20px" color="#ee0a24" />
        </view>
        <!-- AI生成图按钮 -->
        <view class="action-btn ai-btn" bindtap="toggleAiPanel">
          <van-icon name="gem-o" size="20px" color="{{showAiPanel ? '#ee0a24' : '#969799'}}" />
        </view>
      </view>
      <text class="char-count">{{newContent.length}}/500</text>
      <van-button type="primary" size="small" bind:click="onSubmit" round class="submit-btn" loading="{{uploadingImage}}">
        <van-icon name="send" size="16px" /> 发布
      </van-button>
    </view>
  </view>

  <!-- AI生成图面板 -->
  <view class="ai-panel" wx:if="{{showAiPanel}}">
    <view class="ai-panel-header">
      <text class="ai-panel-title">🎨 AI 创作</text>
      <view class="ai-panel-close" bindtap="toggleAiPanel">
        <van-icon name="cross" size="16px" color="#969799" />
      </view>
    </view>
    <view class="ai-panel-content">
      <van-field
        value="{{aiPrompt}}"
        placeholder="描述你想生成的图片..."
        bind:change="onAiPromptInput"
        type="textarea"
        autosize
        border="{{false}}"
        show-confirm-bar="{{false}}"
        class="ai-input"
      />
      <!-- 参考图上传 -->
      <view class="ai-ref-upload" bindtap="onChooseRefImage">
        <van-icon name="photograph" size="20px" color="#969799" />
        <text wx:if="{{!aiRefImageUrl}}">添加参考图</text>
        <text wx:if="{{aiRefImageUrl}}">已选择参考图</text>
      </view>
      <!-- 参考图预览 -->
      <view class="ai-ref-preview" wx:if="{{aiRefImageUrl}}">
        <image src="{{aiRefImageUrl}}" mode="aspectFill" />
        <view class="ai-ref-remove" bindtap="onRemoveRefImage">
          <van-icon name="cross" size="14px" color="#fff" />
        </view>
      </view>
      <!-- 比例选择 -->
      <view class="ai-aspect-select">
        <text class="ai-aspect-label">比例:</text>
        <view class="ai-aspect-options">
          <view class="ai-aspect-btn {{aiAspectRatio === '1:1' ? 'active' : ''}}" bindtap="setAiAspectRatio" data-ratio="1:1">1:1</view>
          <view class="ai-aspect-btn {{aiAspectRatio === '16:9' ? 'active' : ''}}" bindtap="setAiAspectRatio" data-ratio="16:9">16:9</view>
          <view class="ai-aspect-btn {{aiAspectRatio === '9:16' ? 'active' : ''}}" bindtap="setAiAspectRatio" data-ratio="9:16">9:16</view>
        </view>
      </view>
      <!-- AI生成图预览 -->
      <view class="ai-result" wx:if="{{aiImageUrl}}">
        <image src="{{aiImageUrl}}" mode="aspectFill" class="ai-result-image" />
        <view class="ai-result-actions">
          <van-button size="small" round bindtap="insertAiImage">插入留言</van-button>
          <van-button size="small" round type="default" bindtap="clearAiImage">清除</van-button>
        </view>
      </view>
      <!-- AI生成按钮 -->
      <van-button type="primary" block round bindtap="generateAiImage" loading="{{aiGenerating}}" class="ai-generate-btn">
        {{aiGenerating ? '生成中...' : '生成'}}
      </van-button>
    </view>
  </view>

  <!-- 留言列表 -->
  <view class="message-list">
    <view class="section-hint">👇 点击查看更多留言</view>
    <view class="list-header">
      <van-icon name="comment-o" size="18px" color="#ee0a24" />
      <text class="list-title">全部留言</text>
      <text class="list-count">共{{messages.length}}条</text>
    </view>

    <view class="message-card" wx:for="{{messages}}" wx:key="id">
      <!-- 用户信息 -->
      <view class="user-info">
        <view class="user-avatar" wx:if="{{item.avatar}}">
          <image src="{{item.avatar}}" mode="aspectFill" />
        </view>
        <view class="user-avatar" wx:else>{{item.nickname[0]}}</view>
        <view class="user-detail">
          <text class="user-name">{{item.nickname}}</text>
          <text class="user-time">{{item.time}}</text>
        </view>
        <!-- 删除按钮（所有者或管理员可见） -->
        <view class="delete-btn" wx:if="{{currentUser && (currentUser.name === item.nickname || isAdmin)}}" bindtap="onDeleteMessage" data-id="{{item.id}}">
          <van-icon name="delete" size="16px" color="#969799" />
        </view>
      </view>

      <!-- 留言内容 -->
      <view class="message-content" wx:if="{{item.content}}">
        <text>{{item.content}}</text>
      </view>

      <!-- 语音留言 -->
      <view class="voice-message" wx:if="{{item.voice}}" bindtap="onPlayVoice" data-url="{{item.voice}}" data-id="{{item.id}}">
        <view class="voice-icon {{playingVoiceId === item.id ? 'playing' : ''}}">
          <van-icon name="{{playingVoiceId === item.id ? 'music-o' : 'audio'}}" size="24px" color="#fff" />
        </view>
        <view class="voice-wave">
          <view class="wave-bar"></view>
          <view class="wave-bar"></view>
          <view class="wave-bar"></view>
          <view class="wave-bar"></view>
          <view class="wave-bar"></view>
        </view>
        <text class="voice-text">{{playingVoiceId === item.id ? '播放中' : '点击播放'}}</text>
      </view>

      <!-- 图片 -->
      <view class="message-image" wx:if="{{item.image}}">
        <image src="{{item.image}}" mode="aspectFill" class="content-image" bindtap="onPreviewImage" data-url="{{item.image}}" />
      </view>

      <!-- 操作栏 -->
      <view class="action-bar">
        <view class="action-btn {{likeStatus[item.id] && likeStatus[item.id].liked ? 'action-liked' : ''}}" bindtap="onLike" data-id="{{item.id}}">
          <van-icon name="{{likeStatus[item.id] && likeStatus[item.id].liked ? 'like' : 'like-o'}}" />
          <text>{{likeStatus[item.id] ? likeStatus[item.id].count : 0}}</text>
        </view>
        <view class="action-btn" bindtap="toggleCommentPopup" data-id="{{item.id}}">
          <van-icon name="comment-o" />
          <text>{{item.comment_count || 0}}</text>
        </view>
      </view>

      <!-- 内嵌评论区（如微信朋友圈） -->
      <view class="inline-comments" wx:if="{{expandedComments[item.id] && currentMessageId === item.id}}">
        <view class="comments-list">
          <view wx:for="{{currentComments}}" wx:key="id" class="comment-item-inline">
            <text class="comment-inline-name">{{item.nickname}}:</text>
            <text class="comment-inline-content">{{item.content}}</text>
            <text class="comment-inline-delete" wx:if="{{item.can_delete}}" catchtap="onDeleteComment" data-id="{{item.id}}" data-message-id="{{item.message_id}}">删除</text>
          </view>
        </view>
        <!-- 内嵌评论输入 -->
        <view class="inline-comment-input">
          <input type="text" class="inline-input" placeholder="写评论..." value="{{commentContent}}" bindinput="onCommentInput" bindconfirm="onSubmitInlineComment" data-id="{{item.id}}" />
          <text class="inline-submit-btn" catchtap="onSubmitInlineComment" data-id="{{item.id}}">发送</text>
        </view>
      </view>
      <!-- 展开评论提示 -->
      <view class="expand-comments-hint" wx:if="{{item.comment_count > 0 && !expandedComments[item.id]}}" bindtap="toggleCommentPopup" data-id="{{item.id}}">
        <text>展开{{item.comment_count}}条评论</text>
      </view>
    </view>

    <view wx:if="{{messages.length === 0}}" class="empty-state">
      <view class="empty-icon">💬</view>
      <text>还没有留言</text>
      <text class="empty-hint">快来写下第一句吧~</text>
    </view>
  </view>

  <!-- 评论弹窗 -->
  <van-popup
    show="{{commentPopupShow}}"
    position="bottom"
    round
    bind:close="onCloseCommentPopup"
    custom-style="max-height: 70vh;"
  >
    <view class="comment-popup">
      <view class="popup-header">
        <text class="popup-title">评论</text>
        <view class="popup-close" bindtap="onCloseCommentPopup">
          <van-icon name="cross" />
        </view>
      </view>

      <!-- 评论列表 -->
      <scroll-view scroll-y class="comment-list">
        <view wx:if="{{currentComments.length > 0}}" wx:for="{{currentComments}}" wx:key="id" class="comment-item">
          <view class="comment-user">
            <view class="comment-avatar">{{item.nickname[0]}}</view>
            <view class="comment-user-info">
              <text class="comment-name">{{item.nickname}}</text>
              <text class="comment-time">{{item.time}}</text>
            </view>
          </view>
          <text class="comment-content">{{item.content}}</text>
          <view class="comment-actions" wx:if="{{item.can_delete}}">
            <text class="comment-delete" bindtap="onDeleteComment" data-id="{{item.id}}" data-message-id="{{item.message_id}}">删除</text>
          </view>
        </view>
        <view wx:if="{{currentComments.length === 0}}" class="no-comments">
          <van-icon name="chat-o" size="40px" />
          <text>暂无评论，快来抢沙发</text>
        </view>
      </scroll-view>

      <!-- 评论输入 -->
      <view class="comment-input-area">
        <van-field
          value="{{commentContent}}"
          placeholder="写下评论..."
          bind:change="onCommentInput"
          bind:confirm="onSubmitComment"
          size="small"
          round
          clearable
          class="comment-field"
        />
        <van-button
          type="primary"
          size="small"
          round
          bind:click="onSubmitComment"
          disabled="{{!commentContent.trim()}}"
          class="comment-submit-btn"
        >发送</van-button>
      </view>
    </view>
  </van-popup>

  <!-- 悬浮功能按钮 -->
  <view class="float-btns">
    <view class="float-btn" bindtap="toggleDarkMode">
      <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
    </view>
    <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
      <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
    </view>
  </view>
</view>

<van-toast id="van-toast" />
<van-notify id="van-notify" />