.container {
  padding: 0;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  min-height: 100vh;
}

/* 头部区域 */
.header {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  padding: 50rpx 30rpx 80rpx;
  position: relative;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50% 50% 0 0;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 输入区域 */
.input-area {
  background: #fff;
  padding: 30rpx;
  margin: 20rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 10;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.input-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.input-title {
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
  margin-left: 10rpx;
}

.input-field {
  background: #f7f8fa !important;
  border-radius: 16rpx !important;
  padding: 24rpx !important;
  font-size: 28rpx !important;
}

.input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.input-actions {
  display: flex;
  gap: 24rpx;
}

.input-actions .action-btn {
  padding: 8rpx;
}

.voice-record-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.voice-record-btn.recording {
  background: rgba(238, 10, 36, 0.1);
}

.recording-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: rgba(238, 10, 36, 0.05);
  border-radius: 12rpx;
  margin-top: 16rpx;
  color: #ee0a24;
  font-size: 26rpx;
}

.recording-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ee0a24;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}

.recording-tip {
  color: #969799;
  font-size: 22rpx;
}

.image-preview {
  position: relative;
  margin-top: 16rpx;
  display: inline-block;
}

.image-preview image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.remove-image {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.char-count {
  font-size: 24rpx;
  color: #c8c9cc;
}

.submit-btn {
  background: linear-gradient(135deg, #ff6034, #ee0a24) !important;
  border: none !important;
}

/* 留言列表 */
.message-list {
  padding: 0 20rpx 30rpx;
}

.section-hint {
  font-size: 24rpx;
  color: #969799;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}

.list-header {
  display: flex;
  align-items: center;
  padding: 20rpx 10rpx;
}

.list-title {
  font-size: 34rpx;
  color: #2c3e50;
  font-weight: bold;
  margin-left: 10rpx;
}

.list-count {
  font-size: 24rpx;
  color: #969799;
  margin-left: 16rpx;
}

/* 留言卡片 */
.message-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2c3e50, #34495e);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
  overflow: hidden;
}

.user-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
}

.user-time {
  font-size: 22rpx;
  color: #969799;
  margin-top: 4rpx;
}

.user-info .delete-btn {
  margin-left: auto;
  padding: 10rpx;
}

/* 留言内容 */
.message-content {
  font-size: 28rpx;
  color: #323233;
  line-height: 1.7;
  margin-bottom: 20rpx;
  word-break: break-all;
}

/* 图片 */
.message-image {
  margin-bottom: 20rpx;
}

.content-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* 语音留言 */
.voice-message {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.voice-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-icon.playing {
  background: rgba(255, 255, 255, 0.4);
  animation: voicePulse 0.6s infinite;
}

@keyframes voicePulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.voice-wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 40rpx;
}

.wave-bar {
  width: 6rpx;
  height: 100%;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 3rpx;
  animation: wave 0.8s ease-in-out infinite;
}

.wave-bar:nth-child(1) { animation-delay: 0s; }
.wave-bar:nth-child(2) { animation-delay: 0.1s; }
.wave-bar:nth-child(3) { animation-delay: 0.2s; }
.wave-bar:nth-child(4) { animation-delay: 0.3s; }
.wave-bar:nth-child(5) { animation-delay: 0.4s; }

@keyframes wave {
  0%, 100% { height: 20%; }
  50% { height: 100%; }
}

.voice-text {
  color: #fff;
  font-size: 24rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 60rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #969799;
  padding: 10rpx 0;
}

.action-btn .van-icon {
  font-size: 36rpx;
}

.action-liked {
  color: #ee0a24;
}

/* 评论弹窗 */
.comment-popup {
  display: flex;
  flex-direction: column;
  max-height: 70vh;
  background: #fff;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
}

.popup-close {
  padding: 10rpx;
}

.popup-close .van-icon {
  font-size: 36rpx;
  color: #969799;
}

.comment-list {
  flex: 1;
  max-height: 45vh;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.comment-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-user {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2c3e50, #34495e);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.comment-user-info {
  display: flex;
  flex-direction: column;
}

.comment-name {
  font-size: 26rpx;
  color: #323233;
  font-weight: 500;
}

.comment-time {
  font-size: 20rpx;
  color: #969799;
  margin-top: 2rpx;
}

.comment-content {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.6;
  margin-left: 72rpx;
  display: block;
  word-break: break-all;
}

.comment-actions {
  margin-left: 72rpx;
  margin-top: 10rpx;
}

.comment-delete {
  font-size: 22rpx;
  color: #c8c9cc;
}

.comment-delete:active {
  color: #ee0a24;
}

.no-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #969799;
}

.no-comments .van-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.no-comments text {
  font-size: 26rpx;
}

/* 评论输入 */
.comment-input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f5f5;
  background: #fff;
}

.comment-field {
  flex: 1;
  background: #f7f8fa !important;
  border-radius: 36rpx !important;
}

.comment-submit-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #ff6034, #ee0a24) !important;
  border: none !important;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #969799;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #c8c9cc;
  margin-top: 8rpx;
}

.empty-state text {
  font-size: 28rpx;
}

/* 内嵌评论区（如微信朋友圈） */
.inline-comments {
  border-top: 1rpx solid #f5f5f5;
  padding: 16rpx 0;
  margin-top: 16rpx;
}

.inline-comments .comments-list {
  padding: 0;
}

.comment-item-inline {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.comment-inline-name {
  color: #576b95;
  font-weight: 500;
  margin-right: 8rpx;
}

.comment-inline-content {
  color: #333;
  flex: 1;
  word-break: break-all;
}

.comment-inline-delete {
  color: #ee0a24;
  margin-left: 16rpx;
  font-size: 24rpx;
}

.inline-comment-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  margin-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.inline-input {
  flex: 1;
  height: 64rpx;
  background: #f7f8fa;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.inline-submit-btn {
  color: #ee0a24;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 16rpx;
}

.expand-comments-hint {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #576b95;
  border-top: 1rpx dashed #f0f0f0;
  margin-top: 12rpx;
}

/* 夜间模式内嵌评论 */
.dark-mode .inline-comments {
  border-top-color: #3d3d3d;
}

.dark-mode .comment-inline-name {
  color: #6b9ed8;
}

.dark-mode .comment-inline-content {
  color: #e5e5e5;
}

.dark-mode .inline-comment-input {
  border-top-color: #3d3d3d;
}

.dark-mode .inline-input {
  background: #3d3d3d;
  color: #e5e5e5;
}

.dark-mode .expand-comments-hint {
  color: #6b9ed8;
  border-top-color: #3d3d3d;
}

/* 夜间模式样式 */
.dark-mode .container {
  background: linear-gradient(180deg, #1a1a1a 0%, #2d2d2d 100%);
}

.dark-mode .header {
  background: linear-gradient(135deg, #1a1a1a, #2d2d2d) !important;
}

.dark-mode .header::after {
  background: #1a1a1a !important;
}

.dark-mode .input-area {
  background: #2d2d2d !important;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3) !important;
}

.dark-mode .input-title,
.dark-mode .list-title {
  color: #e5e5e5 !important;
}

.dark-mode .char-count {
  color: #888 !important;
}

.dark-mode .message-card {
  background: #2d2d2d !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3) !important;
}

.dark-mode .user-name,
.dark-mode .message-content {
  color: #e5e5e5 !important;
}

.dark-mode .user-time {
  color: #888 !important;
}

.dark-mode .action-bar {
  border-top-color: #3d3d3d !important;
}

.dark-mode .action-btn {
  color: #888 !important;
}

.dark-mode .list-count {
  color: #888 !important;
}

.dark-mode .section-hint {
  color: #666 !important;
}

.dark-mode .comment-popup {
  background: #2d2d2d !important;
}

.dark-mode .popup-title {
  color: #e5e5e5 !important;
}

.dark-mode .popup-header {
  border-bottom-color: #3d3d3d !important;
}

.dark-mode .comment-item {
  border-bottom-color: #3d3d3d !important;
}

.dark-mode .comment-name {
  color: #e5e5e5 !important;
}

.dark-mode .comment-time {
  color: #888 !important;
}

.dark-mode .comment-content {
  color: #888 !important;
}

.dark-mode .comment-input-area {
  border-top-color: #3d3d3d !important;
  background: #2d2d2d !important;
}

.dark-mode .empty-state {
  color: #666 !important;
}

/* 悬浮按钮 */
.float-btns {
  position: fixed;
  right: 30rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 999;
}

.float-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dark-mode .float-btn {
  background: #2d2d2d;
}

.float-btn.music-btn {
  background: linear-gradient(135deg, #ee0a24, #ff6034);
}

.float-btn.music-btn.playing {
  animation: pulse 1.5s infinite;
}

.dark-mode .float-btn.music-btn {
  background: linear-gradient(135deg, #b8192b, #d94a2b);
}
