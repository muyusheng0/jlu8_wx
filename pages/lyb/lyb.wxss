.container {
  padding: 30rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

/* 输入区域 */
.input-area {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.input-field {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx !important;
}

.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  background: linear-gradient(135deg, #07c160, #10b981) !important;
  border: none !important;
}

/* 留言列表 */
.message-list {
  padding: 0;
}

.message-card {
  margin-bottom: 24rpx;
  border-radius: 16rpx !important;
  overflow: hidden;
}

.card-class {
  border-radius: 16rpx !important;
}

.card-title {
  width: 100%;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.nickname {
  font-size: 28rpx;
  color: #323233;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #969799;
}

.card-content {
  margin-top: 16rpx;
}

.content {
  font-size: 28rpx;
  color: #323233;
  line-height: 1.6;
  display: block;
  word-break: break-all;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 48rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1px solid #ebedf0;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #646566;
  font-size: 24rpx;
  padding: 8rpx 0;
}

.action-btn .van-icon {
  font-size: 34rpx;
}

.like-count,
.comment-count {
  margin-left: 4rpx;
  font-size: 24rpx;
}

/* 评论弹窗 */
.comment-popup {
  display: flex;
  flex-direction: column;
  max-height: 60vh;
  background: #fff;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid #ebedf0;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.popup-header .van-icon {
  font-size: 36rpx;
  color: #969799;
}

.comment-list {
  flex: 1;
  max-height: 40vh;
  overflow-y: auto;
  padding-bottom: 20rpx;
}

.comment-cell {
  padding: 24rpx 30rpx !important;
  border-bottom: 1px solid #f7f8fa;
}

.comment-cell .van-cell__title {
  font-size: 26rpx !important;
  color: #323233 !important;
  font-weight: 500;
}

.comment-cell .van-cell__label {
  font-size: 26rpx !important;
  color: #646566 !important;
  margin-top: 8rpx !important;
  line-height: 1.5 !important;
}

.comment-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-time {
  font-size: 20rpx;
  color: #c8c9cc;
}

.delete-btn {
  color: #c8c9cc !important;
  font-size: 32rpx !important;
}

.delete-btn:active {
  color: #ee0a24 !important;
}

.no-comments {
  text-align: center;
  padding: 60rpx 0;
  color: #969799;
  font-size: 26rpx;
}

/* 评论输入 */
.comment-input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #ebedf0;
  background: #fff;
}

.comment-field {
  flex: 1;
  background: #f7f8fa !important;
  border-radius: 36rpx !important;
}

.comment-submit-btn {
  flex-shrink: 0;
  background: #07c160 !important;
  border: none !important;
}
