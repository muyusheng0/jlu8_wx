<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <van-loading wx:if="{{loading}}" vertical />

  <view class="page-header">
    <van-icon name="shield-o" size="24px" color="#ee0a24" />
    <text class="page-title">管理员设置</text>
  </view>

  <view class="student-list" wx:if="{{!loading && students.length > 0}}">
    <van-cell-group border="{{false}}" inset>
      <van-cell wx:for="{{students}}" wx:key="id" title="{{item.name}}" label="学号: {{item.id}}">
        <view slot="right-icon" class="admin-btns">
          <van-switch
            size="24px"
            checked="{{item.is_admin}}"
            active-color="#ee0a24"
            bind:change="onToggleAdmin"
            data-id="{{item.id}}"
          />
          <text class="admin-label">管理员</text>
          <van-switch
            size="24px"
            checked="{{item.is_super_admin}}"
            active-color="#7232dd"
            bind:change="onToggleSuperAdmin"
            data-id="{{item.id}}"
          />
          <text class="admin-label">超管</text>
        </view>
      </van-cell>
    </van-cell-group>
  </view>

  <view class="empty-state" wx:if="{{!loading && students.length === 0}}">
    <view class="empty-icon">👑</view>
    <text>暂无同学数据</text>
  </view>

  <!-- 悬浮功能按钮 -->
  <view class="float-btns">
    <view class="float-btn" bindtap="toggleDarkMode">
      <van-icon name="{{darkMode ? 'sunny-o' : 'moon-o'}}" size="24px" color="{{darkMode ? '#ff6034' : '#666'}}" />
    </view>
    <view class="float-btn music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
      <van-icon name="{{musicPlaying ? 'pause' : 'music-o'}}" size="24px" color="#fff" />
    </view>
  </view>
</view>