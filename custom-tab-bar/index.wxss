.tab-bar {
  display: flex;
  height: 100rpx;
  background: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: #969799;
  font-weight: 500;
  transition: all 0.2s;
}

.tab-item.active .tab-text {
  color: #ee0a24;
  font-size: 28rpx;
  font-weight: 600;
}

.tab-item.active::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #ee0a24;
  border-radius: 2rpx;
}
