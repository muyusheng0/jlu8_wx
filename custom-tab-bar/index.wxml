<van-tabbar
  active="{{ active }}"
  bind:change="onChange"
  fixed
  placeholder
  safe-area-inset-bottom
  active-color="#ee0a24"
  inactive-color="#969799"
>
  <van-tabbar-item
    wx:for="{{ list }}"
    wx:key="name"
    name="{{ item.name }}"
  >
    <view class="tab-emoji">{{ item.emoji }}</view>
    <view class="tab-text">{{ item.text }}</view>
  </van-tabbar-item>
</van-tabbar>
