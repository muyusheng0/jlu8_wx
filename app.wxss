/* 全局样式 */
page {
  background-color: #faf8f5;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 30rpx;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 主按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #e74c3c, #f39c12);
  color: #fff;
  border-radius: 8rpx;
  padding: 24rpx 32rpx;
}

/* 输入框样式 */
.input-field {
  background-color: #fff;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
}

.input-field:focus {
  border-color: #e74c3c;
}

/* 头像样式 */
.avatar {
  border-radius: 50%;
}

.avatar-sm {
  width: 80rpx;
  height: 80rpx;
}

.avatar-md {
  width: 120rpx;
  height: 120rpx;
}

.avatar-lg {
  width: 150rpx;
  height: 150rpx;
}
